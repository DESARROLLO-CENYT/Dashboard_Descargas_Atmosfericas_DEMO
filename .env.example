# =============================================================================
# Plantilla de .env  —  copiar como ".env" en esta misma carpeta y llenar.
# El .env real NO se sube a Git.
#
# En Render estas variables NO salen de aqui: se cargan a mano en el panel
# (Environment), porque la URL de Supabase es un secreto.
# =============================================================================

# --- De donde lee las descargas el tablero -----------------------------------
#   parquet   SOLO local. La copia de datos/ (no esta en git: se genera con
#             scripts/actualizar_parquet.py). Son datos REALES del pipeline,
#             solo que congelados. No se conecta a Supabase aunque la URL de
#             abajo este definida, asi que no gasta egress. Para pruebas,
#             optimizaciones y mejoras antes de ir a produccion.
#   supabase  la base de produccion, y el unico modo de la imagen de Docker.
#             Arranca desde la foto de su cache guardada en la base (~0,75 MB)
#             y baja solo los dias posteriores; sin foto, ~3,9 MB. En local
#             tambien gasta ese egress. Requiere la URL de abajo.
#
# PRODUCCION (Render) usa siempre: FUENTE_DATOS=supabase
FUENTE_DATOS=parquet

# --- Supabase (solo para FUENTE_DATOS=supabase) ------------------------------
# Usuario "dashboard_readonly" por el Transaction pooler (puerto 6543). No usar
# el usuario postgres: el tablero no puede escribir ninguna tabla, solo guardar
# su foto con la funcion de sql/001_foto_tablero.sql.
SUPABASE_DASHBOARD_DB_URL=postgresql://dashboard_readonly.REF_DEL_PROYECTO:TU_PASSWORD@aws-0-us-east-2.pooler.supabase.com:6543/postgres

# --- Fila de la foto de cache (solo para FUENTE_DATOS=supabase) --------------
# Contra la misma base corren dos tableros: el de produccion y este demo, que
# dibuja su red en OTRA ventana de coordenadas. Una foto solo sirve si su caja
# cubre la zona pedida, asi que si comparten fila cada arranque descarta la
# foto del otro y la pisa, y ninguno vuelve a arrancar rapido.
#   1  tablero de produccion (valor por defecto)
#   2  este demo
# Requiere sql/002_foto_por_tablero.sql aplicado. Sin el, el tablero funciona
# igual: no encuentra foto, la arma desde las filas y no toca la de produccion.
#
# PRODUCCION DEL DEMO (Render) usa siempre: FOTO_ID=2
FOTO_ID=2

# --- Refresco del parquet local (opcional, solo en tu maquina) ---------------
# Gold consolidado que deja el pipeline de Airflow. Lo usa
# scripts/actualizar_parquet.py para refrescar la copia de datos/ sin tocar
# Supabase (cero egress). En Render no hace falta.
RUTA_GOLD_PIPELINE=C:\ruta\al\pipeline\Data\3. Gold\Gold_Consolidado_Historico_Descargas_Electricas_GPK.parquet
